# Environment variables template for ResQGrid
RESQGRID_ENV=development
SECRET_KEY=local-only-replace-with-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CSRF_TRUSTED_ORIGINS=
# Optional CARTO-issued basemaps key. Without it, ResQGrid uses OpenStreetMap tiles.
CARTO_API_KEY=
# Optional for local development; production requires a PostgreSQL DATABASE_URL.
DATABASE_URL=
# Optional seed password (minimum 12 characters); only for isolated demo databases.
RESQGRID_DEMO_PASSWORD=
